/* --- Modern Flat, Web-Inspired Dark Theme for ROSBuddy --- */
QWidget {
    background-color: #1e1e1e;
    color: #e4e4e4;
    font-family: 'Inter', 'Segoe UI', 'Roboto', 'Arial', sans-serif;
    font-size: 15px;
    letter-spacing: 0.01em;
}

QMainWindow {
    background-color: #1e1e1e;
}

/* --- Activity Bar (Sidebar) --- */
QToolBar#sidebarToolBar {
    background: #181a1b;
    border: none;
    border-right: 1.5px solid #23272e;
    min-width: 60px;
    max-width: 60px;
    padding: 16px 0 16px 0;
}
QToolBar#sidebarToolBar QToolButton {
    background: transparent;
    color: #b0b0b0;
    border: none;
    border-radius: 8px;
    margin: 10px 0;
    padding: 0;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    font-size: 22px;
    outline: none;
}
QToolBar#sidebarToolBar QToolButton:hover {
    background: #23272e;
    color: #00aeef;
}
QToolBar#sidebarToolBar QToolButton:checked,
QToolBar#sidebarToolBar QToolButton[active="true"] {
    background: #23272e;
    color: #ff6b5c;
    border-left: 4px solid #00aeef;
    border-radius: 8px;
}

/* --- Sidebar Content --- */
#sidebar_content_widget {
    background: #23272e;
    border-right: 1.5px solid #23272e;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    margin: 0;
    padding: 0;
}
#sidebar_content_widget QLineEdit {
    background: #181a20;
    color: #e4e4e4;
    border: 1.5px solid #333333;
    border-radius: 8px;
    padding: 8px 36px 8px 36px;
    margin: 16px 16px 8px 16px;
    font-size: 15px;
    qproperty-placeholderText: #888;
}
#sidebar_content_widget QLineEdit:focus {
    border: 1.5px solid #00aeef;
}
#sidebar_content_widget QLabel {
    color: #b0b0b0;
    font-size: 16px;
    font-weight: 600;
    padding: 12px 0 4px 16px;
}
#sidebar_content_widget QPushButton {
    background: #252525;
    color: #e4e4e4;
    border-radius: 6px;
    padding: 10px 18px;
    margin: 8px 16px 8px 16px;
    border: none;
    font-size: 15px;
    font-weight: 500;
}
#sidebar_content_widget QPushButton:hover {
    background: #00aeef;
    color: #181a1b;
}
#sidebar_content_widget QPushButton:pressed {
    background: #ff6b5c;
    color: #fff;
}

/* --- QTreeView/QListWidget for Navigation --- */
QTreeView, QListWidget {
    background: #23272e;
    border: none;
    outline: none;
    font-size: 15px;
    alternate-background-color: #23272e;
}
QTreeView::item, QListWidget::item {
    padding: 10px 16px;
    border-radius: 6px;
    margin: 2px 0;
    color: #e4e4e4;
}
QTreeView::item:selected, QListWidget::item:selected {
    background: #252525;
    color: #00aeef;
    border: 1.5px solid #00aeef;
}
QTreeView::item:hover, QListWidget::item:hover {
    background: #23272e;
    color: #00aeef;
}
QTreeView::branch, QListWidget::branch {
    background: transparent;
}

/* --- ActionCard (Dashboard/Template Cards) --- */
ActionCard#actionCard, .action-card {
    background: #23272e;
    border: 1.5px solid #23272e;
    border-radius: 10px;
    padding: 18px 20px;
    margin: 10px;
}
ActionCard#actionCard:hover, .action-card:hover {
    border: 1.5px solid #00aeef;
    background: #252525;
}

/* --- Modern Buttons --- */
QPushButton {
    background: #00aeef;
    color: #fff;
    border-radius: 6px;
    padding: 10px 24px;
    font-size: 15px;
    font-weight: 600;
    border: none;
}
QPushButton:hover {
    background: #3a78d1;
    color: #fff;
}
QPushButton:pressed {
    background: #ff6b5c;
    color: #fff;
}
QPushButton[secondary="true"] {
    background: #252525;
    color: #e4e4e4;
    border: 1.5px solid #333333;
}
QPushButton[secondary="true"]:hover {
    background: #23272e;
    color: #00aeef;
    border: 1.5px solid #00aeef;
}

/* --- Inputs --- */
QLineEdit, QTextEdit, QComboBox {
    background: #23272e;
    color: #e4e4e4;
    border: 1.5px solid #333333;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 15px;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1.5px solid #00aeef;
}
QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 28px;
}
QComboBox::down-arrow {
    image: url(:/rosbuddy/ui/resources/icons/arrow-down.svg);
    width: 18px;
    height: 18px;
}

/* --- QCheckBox/QRadioButton --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    font-size: 15px;
    color: #e4e4e4;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1.5px solid #333333;
    background: #23272e;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #00aeef;
    border: 1.5px solid #00aeef;
}

/* --- QTabWidget (Bottom Panel) --- */
QTabWidget::pane {
    border-top: 2px solid #00aeef;
    background: #23272e;
}
QTabBar::tab {
    background: #23272e;
    color: #b0b0b0;
    border: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 24px;
    margin-right: 2px;
    font-size: 15px;
}
QTabBar::tab:selected {
    background: #252525;
    color: #00aeef;
    border-bottom: 2px solid #00aeef;
}
QTabBar::tab:hover {
    background: #23272e;
    color: #00aeef;
}

/* --- QStatusBar --- */
QStatusBar {
    background: #181a1b;
    color: #b0b0b0;
    border-top: 1.5px solid #23272e;
}